<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org/DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="booksearch.MyBook">
    <select id="selectByTitleAndPrice" parameterType="Map" resultType="Book">
        <![CDATA[
            SELECT bisbn, btitle, bprice
            FROM book
            WHERE btitle LIKE '%' || #{btitle} || '%'
            AND bprice < #{bprice}
        ]]>
    </select>
    <select id="selectByISBN" parameterType="String" resultType="Book">
        <![CDATA[
        SELECT *
        FROM book
        WHERE bisbn = #{bisbn}
        ]]>
    </select>
</mapper>