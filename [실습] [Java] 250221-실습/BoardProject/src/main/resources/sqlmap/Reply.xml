<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org/DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="board.Reply">
    <resultMap id="ReplyResultMap" type="Reply">
        <result property="replyId" column="reply_id"/>
        <result property="replyContent" column="reply_content"/>
        <result property="replyWriter" column="reply_writer"/>
        <result property="createDate" column="create_date"/>
        <result property="boardId" column="board_id"/>
    </resultMap>

    <select id="selectById" parameterType="int" resultMap="ReplyResultMap">
        <![CDATA[
        SELECT *
        FROM replies_tbl
        WHERE board_id = #{boardId}
        ORDER BY CREATE_DATE
        ]]>
    </select>

    <select id="selectByReplyId" parameterType="int" resultMap="ReplyResultMap">
        <![CDATA[
        SELECT *
        FROM replies_tbl
        WHERE reply_id = #{replyId}
        ]]>
    </select>

    <select id="countByBoardId" parameterType="int" resultType="int">
        <![CDATA[
        SELECT COUNT(*)
        FROM replies_tbl
        WHERE board_id = #{boardId}
        ]]>
    </select>

    <select id="getLastReplyId" resultType="int">
        SELECT reply_seq.CURRVAL FROM DUAL
    </select>

    <insert id="insertReply" parameterType="Reply">
        <selectKey keyProperty="replyId" resultType="int" order="BEFORE">
            SELECT reply_seq.NEXTVAL FROM dual
        </selectKey>
        <![CDATA[
        INSERT INTO replies_tbl (reply_id, reply_content, reply_writer, create_date, board_id)
        VALUES (#{replyId}, #{replyContent}, #{replyWriter}, SYSDATE, #{boardId})
        ]]>
    </insert>

    <delete id="deleteReply" parameterType="int">
        <![CDATA[
        DELETE
        FROM replies_tbl
        WHERE reply_id = #{replyId}
        ]]>
    </delete>

    <delete id="deleteBoardReply" parameterType="int">
        <![CDATA[
        DELETE
        FROM replies_tbl
        WHERE board_id = #{boardId}
        ]]>
    </delete>
</mapper>